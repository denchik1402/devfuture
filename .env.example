NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Личный Telegram для кнопок на сайте (ник без @)
NEXT_PUBLIC_TELEGRAM_USERNAME=ivan_petrov
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/ivan_petrov

# Бот (отвечает на /start + заявки с формы)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Обязателен на проде (NODE_ENV=production). Без него webhook вернёт 500.
# Сгенерируйте: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# На проде: npm run tg:set-webhook
# Локально (если api.telegram.org доступен): npm run dev + npm run tg:poll

NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Включить вебвизор только осознанно: true
NEXT_PUBLIC_YANDEX_WEBVISOR=false

# Только серверный id (не NEXT_PUBLIC_*)
FORMSPREE_ID=
