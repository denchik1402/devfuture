NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Личный Telegram для кнопок «написать менеджеру» (ник без @)
NEXT_PUBLIC_TELEGRAM_USERNAME=ivan_petrov
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/ivan_petrov

# Username бота (deep-link с сайта: ?start=pkg_bot, order, faq…)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=dfuture_bot

# Telegram Mini App (по умолчанию https://ваш-домен/tg)
# NEXT_PUBLIC_TELEGRAM_MINI_APP_URL=https://devfuture.ru/tg

# Телефон для кнопки «Позвонить» и ЗОЗПП (как показывать на сайте)
NEXT_PUBLIC_PHONE=+7 (985) 490-48-80

# ——— Юридические реквизиты (ЗОЗПП / 152-ФЗ) ———
# Самозанятый: ФИО как в «Мой налог» (не ЕГРЮЛ)
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_TYPE=самозанятый
NEXT_PUBLIC_LEGAL_INN=263111879019
# У самозанятого ОГРН/ОГРНИП нет — оставьте пустым
NEXT_PUBLIC_LEGAL_OGRN=
# Адрес регистрации или населённый пункт деятельности
NEXT_PUBLIC_LEGAL_ADDRESS=г. Москва
NEXT_PUBLIC_LEGAL_EMAIL=help@devfuture.ru
NEXT_PUBLIC_LEGAL_DOCS_UPDATED=2026-09-04

# Бот (отвечает на /start + заявки с формы)
# Проверка: npm run tg:check
# Новый токен: @BotFather → /mybots → API Token (или Revoke)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Обязателен на проде (NODE_ENV=production). Без него webhook вернёт 500.
# Сгенерируйте: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Доп. админы бота (через запятую). По умолчанию админ = TELEGRAM_CHAT_ID.
# TELEGRAM_ADMIN_IDS=123456789,987654321

# Cron ops (SLA reminders + digest): openssl rand -hex 24
# CRON_SECRET=
# crontab: 0 * * * * curl -fsS -H "x-cron-secret: $CRON_SECRET" https://devfuture.ru/api/cron/ops
# Weekly digest: .../api/cron/ops?digest=1

# CRM: webhook (Make / Zapier / Sheets / Notion). POST JSON на каждую заявку.
# LEADS_WEBHOOK_URL=https://hook.eu2.make.com/...
# После деплоя проверьте: curl https://ваш-домен/api/health
# Бэкап .data: scripts/backup-bot-data.sh (cron) — см. DEPLOY.md
# IndexNow (Yandex). Same value must be in public/indexnow-key.txt
# INDEXNOW_KEY=

# Если VPS не достучится до api.telegram.org — прокси Bot API (зарубежный сервер):
# TELEGRAM_API_BASE=https://tg-proxy.ваш-домен
# TELEGRAM_PROXY_SECRET=тот_же_что_PROXY_SECRET_на_прокси
# Если Telegram не достучится ДО сайта (getWebhookInfo: Connection timed out):
# TELEGRAM_WEBHOOK_URL=https://tg-proxy.ваш-домен/webhook
# Полная инструкция: scripts/telegram-bot-api-proxy/SETUP.md

# На проде: npm run tg:set-webhook
# Локально: npm run tg:poll
# Диагностика: npm run tg:check / npm run tg:probe
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Включить вебвизор только осознанно: true
NEXT_PUBLIC_YANDEX_WEBVISOR=false

# Только серверный id (не NEXT_PUBLIC_*)
FORMSPREE_ID=
